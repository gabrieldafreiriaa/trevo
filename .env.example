# Copie para .env.local e preencha.
# Local: os valores aparecem ao rodar `pnpm db:start`.
# Produção: Supabase → Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRETA. Só usada no servidor (convite de usuários, S6).
# Nunca exponha no cliente nem faça commit dela.
SUPABASE_SERVICE_ROLE_KEY=
